{
  "name": "sandbox-editor",
  "scripts": {
    "start": "node ./node_modules/webpack-dev-server/bin/webpack-dev-server.js --config webpack.dev.js",
    "build": "NODE_ENV='production' node ./node_modules/webpack/bin/webpack.js --progress --config webpack.prod.js",
    "lint": "eslint src",
    "lint:fix": "eslint --fix",
    "test:esm": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" npx jest -c=jest.config.mjs --no-cache",
    "test:vitest": "vitest run -c ./vitest.config.ts",
    "test:mocha-ts": "TS_NODE_PROJECT=\"mocha-tests/tsconfig.mocha-ts.json\" mocha --loader=ts-node/esm --config=.mocharc.json",
    "test:browser": "rollup --config=rollup.config.js --input=browser-test/index.test.ts && http-server ./ --port=8080 -c-1 -o output/index.html",
    "clean": "rm -rf ./output/*"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
